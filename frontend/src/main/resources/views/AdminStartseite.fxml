<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane
        xmlns="http://javafx.com/javafx/21"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="com.banking.frontend.admin.AdminStartseiteController"
        prefWidth="1150"
        prefHeight="720"
        styleClass="page-background">

    <stylesheets>
        <URL value="@../css/app.css"/>
    </stylesheets>

    <top>

        <HBox alignment="CENTER_LEFT" spacing="20" styleClass="top-bar">

            <padding>
                <Insets top="22" right="35" bottom="22" left="35"/>
            </padding>

            <VBox spacing="4">

                <Label
                        text="Admin Dashboard"
                        styleClass="page-title"/>

                <Label
                        fx:id="adminNameLabel"
                        text="Admin"
                        styleClass="info-label"/>

                <Label
                        fx:id="roleLabel"
                        text="Rolle: ADMIN"
                        styleClass="info-label"/>

            </VBox>

            <Region HBox.hgrow="ALWAYS"/>

            <Button
                    fx:id="logoutButton"
                    text="Abmelden"
                    styleClass="logout-button"
                    onAction="#handleLogout"/>

        </HBox>

    </top>

    <center>

        <VBox spacing="20">

            <padding>
                <Insets top="30" right="35" bottom="35" left="35"/>
            </padding>

            <HBox alignment="CENTER_LEFT">

                <VBox spacing="3">

                    <Label
                            text="Benutzerverwaltung"
                            styleClass="section-title"/>

                    <Label
                            text="Alle registrierten Benutzer des Banksystems"
                            styleClass="subtitle"/>

                </VBox>

                <Region HBox.hgrow="ALWAYS"/>

                <Button
                        fx:id="refreshButton"
                        text="Aktualisieren"
                        styleClass="secondary-button"
                        onAction="#handleRefresh"/>

                <Region prefWidth="10"/>

                <Button
                        fx:id="createUserButton"
                        text="Benutzer anlegen"
                        styleClass="primary-button"
                        onAction="#handleCreateUser"/>

            </HBox>

            <TableView
                    fx:id="userTable"
                    VBox.vgrow="ALWAYS">

                <columns>

                    <TableColumn
                            fx:id="idColumn"
                            text="ID"
                            prefWidth="55"/>

                    <TableColumn
                            fx:id="usernameColumn"
                            text="Benutzername"
                            prefWidth="135"/>

                    <TableColumn
                            fx:id="firstNameColumn"
                            text="Vorname"
                            prefWidth="120"/>

                    <TableColumn
                            fx:id="lastNameColumn"
                            text="Nachname"
                            prefWidth="120"/>

                    <TableColumn
                            fx:id="emailColumn"
                            text="E-Mail"
                            prefWidth="200"/>

                    <TableColumn
                            fx:id="geburtstagColumn"
                            text="Geburtstag"
                            prefWidth="120"/>

                    <TableColumn
                            fx:id="roleColumn"
                            text="Rolle"
                            prefWidth="100"/>

                    <TableColumn
                            fx:id="statusColumn"
                            text="Status"
                            prefWidth="110"/>

                </columns>

            </TableView>

        </VBox>

    </center>

</BorderPane>