<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane
        xmlns="http://javafx.com/javafx/21"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="com.banking.frontend.admin.AdminStartseiteController"
        prefWidth="1100"
        prefHeight="700">

    <!-- Kopfbereich -->
    <top>

        <HBox
                alignment="CENTER_LEFT"
                spacing="20"
                style="-fx-background-color: #f4f4f4;">

            <padding>
                <Insets top="20"
                        right="30"
                        bottom="20"
                        left="30"/>
            </padding>

            <VBox
                    spacing="5"
                    HBox.hgrow="ALWAYS">

                <Label
                        text="Admin Dashboard"
                        style="-fx-font-size: 26px; -fx-font-weight: bold;"/>

                <Label
                        fx:id="adminNameLabel"
                        text="Admin"/>

                <Label
                        fx:id="roleLabel"
                        text="Rolle: ADMIN"/>

            </VBox>

            <!-- Abmelden -->
            <Button
                    fx:id="logoutButton"
                    text="Abmelden"
                    prefWidth="120"
                    prefHeight="40"
                    onAction="#handleLogout"/>

        </HBox>

    </top>


    <!-- Hauptbereich -->
    <center>

        <VBox spacing="20">

            <padding>
                <Insets top="30"
                        right="30"
                        bottom="30"
                        left="30"/>
            </padding>

            <Label
                    text="Benutzerverwaltung"
                    style="-fx-font-size: 22px; -fx-font-weight: bold;"/>

            <!-- Tabelle mit allen Benutzern -->
            <TableView
                    fx:id="userTable"
                    prefHeight="500">

                <columns>

                    <TableColumn
                            fx:id="idColumn"
                            text="ID"
                            prefWidth="60"/>

                    <TableColumn
                            fx:id="usernameColumn"
                            text="Benutzername"
                            prefWidth="130"/>

                    <TableColumn
                            fx:id="firstNameColumn"
                            text="Vorname"
                            prefWidth="120"/>

                    <TableColumn
                            fx:id="lastNameColumn"
                            text="Nachname"
                            prefWidth="120"/>

                    <TableColumn
                            fx:id="emailColumn"
                            text="E Mail"
                            prefWidth="190"/>

                    <TableColumn
                            fx:id="geburtstagColumn"
                            text="Geburtstag"
                            prefWidth="120"/>

                    <TableColumn
                            fx:id="roleColumn"
                            text="Rolle"
                            prefWidth="100"/>

                    <TableColumn
                            fx:id="statusColumn"
                            text="Status"
                            prefWidth="100"/>

                </columns>

            </TableView>


            <!-- Aktionen -->
            <HBox spacing="15">

                <Button
                        fx:id="createUserButton"
                        text="Benutzer anlegen"
                        prefWidth="180"
                        prefHeight="45"
                        onAction="#handleCreateUser"/>

                <Button
                        fx:id="refreshButton"
                        text="Aktualisieren"
                        prefWidth="150"
                        prefHeight="45"
                        onAction="#handleRefresh"/>

            </HBox>

        </VBox>

    </center>

</BorderPane>