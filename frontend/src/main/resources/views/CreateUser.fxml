<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane
        xmlns="http://javafx.com/javafx/21"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="com.banking.frontend.admin.CreateUserController"
        prefWidth="650"
        prefHeight="760"
        styleClass="page-background">

    <stylesheets>
        <URL value="@../css/app.css"/>
    </stylesheets>

    <VBox
            spacing="16"
            maxWidth="500"
            styleClass="card">

        <padding>
            <Insets top="30" right="35" bottom="30" left="35"/>
        </padding>

        <Label
                text="Benutzer anlegen"
                styleClass="page-title"/>

        <Label
                text="Erstelle einen neuen Bankbenutzer"
                styleClass="subtitle"/>

        <VBox spacing="6">

            <Label
                    text="Benutzername"
                    styleClass="info-label"/>

            <TextField
                    fx:id="usernameField"
                    promptText="Benutzername"
                    prefHeight="43"/>

        </VBox>

        <HBox spacing="12">

            <VBox spacing="6" HBox.hgrow="ALWAYS">

                <Label
                        text="Vorname"
                        styleClass="info-label"/>

                <TextField
                        fx:id="firstNameField"
                        promptText="Vorname"
                        prefHeight="43"
                        maxWidth="Infinity"/>

            </VBox>

            <VBox spacing="6" HBox.hgrow="ALWAYS">

                <Label
                        text="Nachname"
                        styleClass="info-label"/>

                <TextField
                        fx:id="lastNameField"
                        promptText="Nachname"
                        prefHeight="43"
                        maxWidth="Infinity"/>

            </VBox>

        </HBox>

        <VBox spacing="6">

            <Label
                    text="E-Mail"
                    styleClass="info-label"/>

            <TextField
                    fx:id="emailField"
                    promptText="E-Mail"
                    prefHeight="43"/>

        </VBox>

        <VBox spacing="6">

            <Label
                    text="Geburtstag"
                    styleClass="info-label"/>

            <TextField
                    fx:id="geburtstagField"
                    promptText="JJJJ-MM-TT"
                    prefHeight="43"/>

        </VBox>

        <HBox spacing="12">

            <VBox spacing="6" HBox.hgrow="ALWAYS">

                <Label
                        text="Passwort"
                        styleClass="info-label"/>

                <PasswordField
                        fx:id="passwordField"
                        promptText="Passwort"
                        prefHeight="43"
                        maxWidth="Infinity"/>

            </VBox>

            <VBox spacing="6" HBox.hgrow="ALWAYS">

                <Label
                        text="Passwort bestätigen"
                        styleClass="info-label"/>

                <PasswordField
                        fx:id="confirmPasswordField"
                        promptText="Wiederholen"
                        prefHeight="43"
                        maxWidth="Infinity"/>

            </VBox>

        </HBox>

        <Label
                fx:id="messageLabel"
                text=""
                wrapText="true"
                styleClass="message-label"/>

        <Button
                fx:id="createUserButton"
                text="Benutzer erstellen"
                maxWidth="Infinity"
                prefHeight="45"
                styleClass="primary-button"
                onAction="#handleCreateUser"/>

        <Button
                fx:id="backButton"
                text="Zurück"
                maxWidth="Infinity"
                prefHeight="42"
                styleClass="secondary-button"
                onAction="#handleBack"/>

    </VBox>

</StackPane>