<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox
        xmlns="http://javafx.com/javafx/21"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="com.banking.frontend.admin.CreateUserController"
        alignment="CENTER"
        spacing="15"
        prefWidth="500"
        prefHeight="650">

    <padding>
        <Insets top="40" right="60" bottom="40" left="60"/>
    </padding>

    <!-- Überschrift -->
    <Label
            text="Benutzer anlegen"
            style="-fx-font-size: 28px; -fx-font-weight: bold;"/>

    <Label
            text="Neuen Bankbenutzer erstellen"/>


    <!-- Benutzername -->
    <TextField
            fx:id="usernameField"
            promptText="Benutzername"
            prefHeight="42"/>

    <!-- Passwort -->
    <PasswordField
            fx:id="passwordField"
            promptText="Passwort"
            prefHeight="42"/>


    <!-- Passwort wiederholen -->
    <PasswordField
            fx:id="confirmPasswordField"
            promptText="Passwort wiederholen"
            prefHeight="42"/>

    <!-- E Mail -->
    <TextField
            fx:id="emailField"
            promptText="E Mail"
            prefHeight="42"/>


    <!-- Vorname -->
    <TextField
            fx:id="firstNameField"
            promptText="Vorname"
            prefHeight="42"/>


    <!-- Nachname -->
    <TextField
            fx:id="lastNameField"
            promptText="Nachname"
            prefHeight="42"/>

    <!-- Geburtstag -->
    <TextField
            fx:id="geburtstagField"
            promptText="Geburtstag (JJJJ-MM-TT)"
            prefHeight="42"/>




    <!-- Meldung für Erfolg oder Fehler -->
    <Label
            fx:id="messageLabel"
            text=""/>


    <!-- Benutzer erstellen -->
    <Button
            fx:id="createUserButton"
            text="Benutzer erstellen"
            prefWidth="300"
            prefHeight="45"
            onAction="#handleCreateUser"/>


    <!-- Zurück zur Admin Startseite -->
    <Button
            fx:id="backButton"
            text="Zurück"
            prefWidth="300"
            prefHeight="40"
            onAction="#handleBack"/>

</VBox>