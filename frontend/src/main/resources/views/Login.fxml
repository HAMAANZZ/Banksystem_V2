<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane
        xmlns="http://javafx.com/javafx/21"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="com.banking.frontend.auth.LoginController"
        prefWidth="520"
        prefHeight="620"
        styleClass="page-background">

    <stylesheets>
        <URL value="@../css/app.css"/>
    </stylesheets>

    <VBox
            alignment="CENTER"
            spacing="18"
            maxWidth="380"
            styleClass="card">

        <padding>
            <Insets top="35" right="35" bottom="35" left="35"/>
        </padding>

        <Label
                text="Banksystem"
                styleClass="page-title"/>

        <Label
                text="Willkommen zurück"
                styleClass="subtitle"/>

        <VBox spacing="7">

            <Label
                    text="Benutzername"
                    styleClass="info-label"/>

            <TextField
                    fx:id="usernameField"
                    promptText="Benutzername"
                    text="admin"
                    prefHeight="45"
                    maxWidth="Infinity"/>

        </VBox>

        <VBox spacing="7">

            <Label
                    text="Passwort"
                    styleClass="info-label"/>

            <PasswordField
                    fx:id="passwordField"
                    promptText="Passwort"
                    text="Admin12345"
                    prefHeight="45"
                    maxWidth="Infinity"
                    onAction="#handleLogin"/>

        </VBox>

        <Label
                fx:id="messageLabel"
                text=""
                wrapText="true"
                styleClass="message-label"/>

        <Button
                fx:id="loginButton"
                text="Anmelden"
                maxWidth="Infinity"
                prefHeight="46"
                styleClass="primary-button"
                onAction="#handleLogin"/>

    </VBox>

</StackPane>