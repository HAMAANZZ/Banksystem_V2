<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane
        xmlns="http://javafx.com/javafx/21"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="com.banking.frontend.dashboard.StartseiteController"
        prefWidth="1100"
        prefHeight="720"
        styleClass="root-container">

    <stylesheets>
        <URL value="@../css/startseite.css"/>
    </stylesheets>


    <!-- Kopfbereich -->
    <top>

        <HBox alignment="CENTER_LEFT" spacing="20" styleClass="top-bar">

            <padding>
                <Insets top="22" right="35" bottom="22" left="35"/>
            </padding>


            <VBox spacing="4">

                <Label
                        fx:id="greetingLabel"
                        text="Guten Tag"
                        styleClass="greeting-label"/>

                <Label
                        fx:id="usernameLabel"
                        text="Benutzer wird geladen..."
                        styleClass="user-info-label"/>

                <Label
                        fx:id="roleLabel"
                        text="Rolle wird geladen..."
                        styleClass="user-info-label"/>

            </VBox>


            <!-- Drückt Abmelden nach rechts -->
            <Region HBox.hgrow="ALWAYS"/>


            <Button
                    fx:id="logoutButton"
                    text="Abmelden"
                    onAction="#handleLogout"
                    styleClass="logout-button"/>

        </HBox>

    </top>


    <!-- Hauptbereich -->
    <center>

        <VBox spacing="26" styleClass="content-container">

            <padding>
                <Insets top="32" right="45" bottom="35" left="45"/>
            </padding>


            <!-- Konto Karte -->
            <VBox spacing="10" styleClass="account-card">

                <Label
                        text="Mein Konto"
                        styleClass="section-title"/>

                <Label
                        text="Verfügbarer Kontostand"
                        styleClass="muted-label"/>

                <Label
                        fx:id="balanceLabel"
                        text="0,00 €"
                        styleClass="balance-label"/>

                <HBox alignment="CENTER_LEFT" spacing="10">

                    <Label
                            text="Kontonummer"
                            styleClass="account-number-title"/>

                    <Label
                            fx:id="accountNumberLabel"
                            text="wird geladen..."
                            styleClass="account-number-label"/>

                </HBox>

            </VBox>


            <!-- Banking Aktionen -->
            <VBox spacing="14">

                <Label
                        text="Banking"
                        styleClass="section-title"/>


                <HBox spacing="16">

                    <Button
                            fx:id="depositButton"
                            text="Einzahlen"
                            onAction="#handleDeposit"
                            maxWidth="Infinity"
                            HBox.hgrow="ALWAYS"
                            styleClass="banking-button"/>

                    <Button
                            fx:id="withdrawButton"
                            text="Auszahlen"
                            onAction="#handleWithdraw"
                            maxWidth="Infinity"
                            HBox.hgrow="ALWAYS"
                            styleClass="banking-button"/>

                    <Button
                            fx:id="transferButton"
                            text="Überweisen"
                            onAction="#handleTransfer"
                            maxWidth="Infinity"
                            HBox.hgrow="ALWAYS"
                            styleClass="primary-banking-button"/>

                </HBox>

            </VBox>


            <!-- Transaktionen -->
            <VBox spacing="14" VBox.vgrow="ALWAYS">

                <HBox alignment="CENTER_LEFT">

                    <VBox spacing="2">

                        <Label
                                text="Letzte Transaktionen"
                                styleClass="section-title"/>

                        <Label
                                text="Deine letzten Kontobewegungen"
                                styleClass="muted-label"/>

                    </VBox>

                </HBox>


                <ListView
                        fx:id="transactionsListView"
                        VBox.vgrow="ALWAYS"
                        styleClass="transaction-list"/>

            </VBox>

        </VBox>

    </center>

</BorderPane>